import io
import logging
import os
import base64
import httpx
from fastapi import FastAPI, Request
from openai import OpenAI
logging.basicConfig(level=logging.INFO)
logger = logging.getLogger(__name__)
TELEGRAM_BOT_TOKEN = os.environ["TELEGRAM_BOT_TOKEN"]
OPENAI_API_KEY = os.environ["OPENAI_API_KEY"]
OPENAI_MODEL = os.getenv("OPENAI_MODEL", "gpt-image-2")
PUBLIC_URL = os.getenv("PUBLIC_URL", "").rstrip("/")
app = FastAPI(title="Zews77 AI Image Bot")
openai_client = OpenAI(api_key=OPENAI_API_KEY)
telegram_base = f"https://api.telegram.org/bot{TELEGRAM_BOT_TOKEN}"
async def telegram(method: str, **kwargs):
    async with httpx.AsyncClient(timeout=120) as client:
        response = await client.post(
            f"{telegram_base}/{method}",
            data=kwargs
        )
        response.raise_for_status()
        return response.json()
async def download_telegram_file(file_id: str) -> bytes:
    info = await telegram("getFile", file_id=file_id)
    file_path = info["result"]["file_path"]
    async with httpx.AsyncClient(timeout=120) as client:
        response = await client.get(
            f"https://api.telegram.org/file/bot{TELEGRAM_BOT_TOKEN}/{file_path}"
        )
        response.raise_for_status()
        return response.content
def edit_image(image_bytes: bytes, instruction: str) -> bytes:
    result = openai_client.images.edit(
        model=OPENAI_MODEL,
        image=io.BytesIO(image_bytes),
        prompt=(
            "Edit the provided image according to the user's instruction. "
            "Preserve the original subject, composition, proportions and important details "
            "unless the instruction explicitly asks to change them. "
            "Make only the requested changes. "
            f"User instruction: {instruction}"
        ),
    )
    item = result.data[0]
    image_b64 = getattr(item, "b64_json", None)
    if not image_b64:
        raise RuntimeError("OpenAI did not return image data")
    return base64.b64decode(image_b64)
async def process_message(message: dict):
    chat = message.get("chat", {})
    chat_id = chat.get("id")
    if not chat_id:
        return
    if message.get("text", "").strip() == "/start":
        await telegram(
            "sendMessage",
            chat_id=chat_id,
            text=(
                "Привет! Я AI-бот для обработки изображений.\n\n"
                "Пришли фотографию с подписью-инструкцией, например:\n"
                "«Сделай косметичку нежно-фиолетовой»\n\n"
                "Я обработаю изображение и верну результат."
            ),
        )
        return
    photo = message.get("photo")
    if not photo:
        await telegram(
            "sendMessage",
            chat_id=chat_id,
            text="Пришли изображение и напиши в подписи, что нужно изменить.",
        )
        return
    instruction = (message.get("caption") or "").strip()
    if not instruction:
        await telegram(
            "sendMessage",
            chat_id=chat_id,
            text=(
                "Добавь к фотографии подпись с инструкцией, "
                "например: «Замени цвет на нежно-фиолетовый»."
            ),
        )
        return
    await telegram(
        "sendChatAction",
        chat_id=chat_id,
        action="upload_photo"
    )
    try:
        file_id = photo[-1]["file_id"]
        image_bytes = await download_telegram_file(file_id)
        edited = edit_image(image_bytes, instruction)
        files = {
            "photo": ("edited.png", edited, "image/png")
        }
        data = {
            "chat_id": str(chat_id),
            "caption": "Готово ✨"
        }
        async with httpx.AsyncClient(timeout=180) as client:
            response = await client.post(
                f"{telegram_base}/sendPhoto",
                data=data,
                files=files
            )
            response.raise_for_status()
    except Exception:
        logger.exception("Image processing failed")
        await telegram(
            "sendMessage",
            chat_id=chat_id,
            text=(
                "Не получилось обработать изображение. "
                "Попробуй ещё раз с другой формулировкой."
            ),
        )
@app.get("/")
async def health():
    return {
        "status": "ok",
        "bot": "Zews77 AI Image Bot"
    }
@app.post("/telegram/webhook")
async def webhook(request: Request):
    update = await request.json()
    message = update.get("message")
    if message:
        await process_message(message)
    return {"ok": True}
@app.on_event("startup")
async def startup():
    if PUBLIC_URL:
        webhook_url = f"{PUBLIC_URL}/telegram/webhook"
        try:
            await telegram(
                "setWebhook",
                url=webhook_url
            )
            logger.info(
                "Telegram webhook configured: %s",
                webhook_url
            )
        except Exception:
            logger.exception(
                "Could not configure Telegram webhook"
            )